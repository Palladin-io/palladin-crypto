{
  "name": "@palladin/crypto",
  "version": "0.2.0",
  "description": "Candidate shared zero-knowledge crypto package for Palladin clients; consumer cutover is pending.",
  "license": "Apache-2.0",
  "author": "Patryk Roguszewski <patryk.roguszewski@palladin.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palladin-io/palladin-crypto.git"
  },
  "homepage": "https://github.com/Palladin-io/palladin-crypto#readme",
  "bugs": "https://github.com/Palladin-io/palladin-crypto/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SBOM.cdx.json",
    "TRADEMARKS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "oss:generate": "node scripts/generate-oss-metadata.mjs",
    "oss:check": "node scripts/generate-oss-metadata.mjs --check",
    "package:check": "node scripts/check-package-contents.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm run oss:check && npm run package:check"
  },
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "hash-wasm": "^4.12.0",
    "libsodium-wrappers": "^0.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.8.2",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
